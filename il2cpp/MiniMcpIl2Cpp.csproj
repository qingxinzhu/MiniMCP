<Project Sdk="Microsoft.NET.Sdk">

  <!-- ===================================================================
       MiniMCP (IL2CPP Edition) - BepInEx 6 IL2CPP plugin
       只改下面一个地方：GameDir 指向你的游戏根目录（含 BepInEx/ 的那个）
       =================================================================== -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Path\To\YourGame</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <BepInExInterop>$(GameDir)\BepInEx\interop</BepInExInterop>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MiniMCP.Il2Cpp</AssemblyName>
    <RootNamespace>MiniMCP.Il2Cpp</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CS0168;CS0219</NoWarn>

    <!-- 发布用：不生成 PDB，并把编译机路径映射成占位符（防止泄露本地路径） -->
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src,$(MSBuildProjectDirectory)/../=/</PathMap>
    <RepositoryUrl>https://github.com/qingxinzhu/MiniMCP</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx 6 core -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- IL2CPP interop 程序集（由 BepInEx 首次启动时自动生成） -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(BepInExInterop)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(BepInExInterop)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BepInExInterop)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(BepInExInterop)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
